import { FocusStyle } from "controls.slint";
import { FileTypeIcon } from "icons.slint";
import { PausedTransferDetails } from "transfer_details.slint";
import { ScrollView } from "std-widgets.slint";

export struct TableItem {
    id: int,
    filename: string,
    file_type: string,
    size_text: string,
    status_text: string,
    time_left_text: string,
    transfer_rate_text: string,
    downloaded_text: string,
    // Byte counts exceed int, so they travel as float to sort numerically.
    size_bytes: float,
}

component DownloadRowColumns inherits HorizontalLayout {
    in property <string> filename;
    in property <string> file_type;
    in property <string> size_text;
    in property <string> status_text;
    in property <string> time_left_text;
    in property <string> transfer_rate_text;
    in property <string> downloaded_text;
    in property <bool> is_active: false;
    in property <color> status_color: #10b981;

    padding-left: 8px;
    padding-right: 8px;
    spacing: 0px;

    HorizontalLayout {
        horizontal-stretch: 3;
        spacing: 6px;
        alignment: start;
        FileTypeIcon { file-type: root.file_type; }
        Text {
            text: root.filename;
            font-size: 11px;
            color: root.is_active ? #f4f4f5 : #d4d4d8;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    HorizontalLayout {
        width: 125px;
        padding-left: 6px;
        alignment: start;
        Text {
            text: root.size_text;
            font-size: 11px;
            color: root.is_active ? #d4d4d8 : #71717a;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    HorizontalLayout {
        width: 125px;
        padding-left: 6px;
        alignment: start;
        Text {
            text: root.status_text;
            font-size: 11px;
            color: root.status_color;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    HorizontalLayout {
        width: 80px;
        padding-left: 6px;
        alignment: start;
        Text {
            text: root.time_left_text;
            font-size: 11px;
            color: root.is_active ? #d4d4d8 : #52525b;
            vertical-alignment: center;
        }
    }

    HorizontalLayout {
        width: 90px;
        padding-left: 6px;
        alignment: start;
        Text {
            text: root.transfer_rate_text;
            font-size: 11px;
            color: root.is_active ? #d4d4d8 : #52525b;
            vertical-alignment: center;
        }
    }

    HorizontalLayout {
        width: 90px;
        padding-left: 6px;
        alignment: start;
        Text {
            text: root.downloaded_text;
            font-size: 11px;
            color: root.is_active ? #71717a : #52525b;
            vertical-alignment: center;
        }
    }
}

// A header label that sorts its column when clicked or activated from the keyboard.
component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <int> column;
    in property <bool> active: false;
    in property <bool> ascending: true;
    callback clicked(int);

    horizontal-stretch: 1;
    forward-focus: header_focus;
    accessible-role: button;
    accessible-label: "Sort by " + root.label;
    accessible-action-default => { root.clicked(root.column); }

    HorizontalLayout {
        alignment: start;
        spacing: 5px;

        Text {
            horizontal-stretch: 1;
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: root.active ? #f4f4f5 : #a1a1aa;
            vertical-alignment: center;
            overflow: elide;
        }
        // 1px square bars; the long-to-short order encodes the direction.
        VerticalLayout {
            alignment: center;
            width: 8px;
            Path {
                visible: root.active;
                width: 8px;
                height: 6px;
                commands: root.ascending
                    ? "M 0 0.5 L 8 0.5 M 0 3 L 5 3 M 0 5.5 L 2.5 5.5"
                    : "M 0 0.5 L 2.5 0.5 M 0 3 L 5 3 M 0 5.5 L 8 5.5";
                stroke: #f4f4f5;
                stroke-width: 1px;
            }
        }
    }
    header_focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked(root.column);
                return accept;
            }
            return reject;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            header_focus.focus();
            root.clicked(root.column);
        }
    }
}

export component DownloadTable inherits ScrollView {
    in property <bool> active_row_visible: false;
    in-out property <int> selected_row: 0;
    in property <bool> is_completed: false;
    in property <bool> is_paused: false;
    in property <bool> is_resumable: false;
    in property <string> active_filename: "";
    in property <string> active_file_type: "doc";
    in property <string> active_size: "0 B";
    in property <string> active_status: "Idle";
    in property <color> active_status_color: #71717a;
    in property <string> active_time_left: "--:--";
    in property <string> active_transfer_rate: "0 KB/s";
    in property <string> active_downloaded: "Today";
    in property <int> selected_category: 0;
    in property <int> total_items: 0;
    in property <[TableItem]> sample_downloads: [];
    // -1 until a header is clicked; then the column index that orders the listed rows.
    in-out property <int> sort_column: -1;
    in-out property <bool> sort_ascending: true;
    // Rows paint their focus ring only for keyboard input, so a click selects without a ring.
    private property <bool> keyboard_focused: false;
    callback open_file();
    callback row_selected(int);
    /// Moves the selection by one row: -1 for up, 1 for down.
    callback step_selection(int);
    /// A sortable header was activated.
    callback sort_requested(int);
    pure function category_matches(category: int, file_type: string, completed: bool) -> bool {
        return category == 0
            || (category == 1 && file_type == "zip")
            || (category == 2 && file_type == "doc")
            || (category == 3 && file_type == "audio")
            || (category == 4 && file_type == "exe")
            || (category == 5 && file_type == "video")
            || (category == 6 && !completed)
            || (category == 7 && completed);
    }

    content-width: max(self.visible-width, 820px);
    content-height: self.visible-height;
    horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
    vertical-scrollbar-policy: ScrollBarPolicy.always-off;

    Rectangle {
        width: root.content-width;
        height: root.content-height;
        background: #141416;

        // The list is one keyboard stop, so the arrows move the selection through the rows.
        list_focus := FocusScope {
            key-pressed(event) => {
                // Any key here means the keyboard drives the list, so the ring is shown again.
                root.keyboard_focused = true;
                if event.text == Key.DownArrow {
                    root.step_selection(1);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.step_selection(-1);
                    return accept;
                }
                if event.text == Key.Return || event.text == Key.Space {
                    // Nothing is selected yet: the first press picks the top row instead.
                    if root.selected_row > 0 {
                        root.row_selected(root.selected_row);
                    } else {
                        root.step_selection(1);
                    }
                    return accept;
                }
                return reject;
            }
        }
    }

    VerticalLayout {
        width: root.content-width;
        height: root.content-height;
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 25px;
            background: #1f1f23;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 0px;

                HorizontalLayout {
                    horizontal-stretch: 3;
                    HeaderCell { label: "File Name"; column: 0; active: root.sort_column == 0; ascending: root.sort_ascending; clicked(col) => { root.sort_requested(col); } }
                    Rectangle { width: 1px; background: #27272a; }
                }
                HorizontalLayout {
                    width: 125px; padding-left: 6px;
                    HeaderCell { label: "Size"; column: 1; active: root.sort_column == 1; ascending: root.sort_ascending; clicked(col) => { root.sort_requested(col); } }
                    Rectangle { width: 1px; background: #27272a; }
                }
                HorizontalLayout {
                    width: 125px; padding-left: 6px;
                    Text { text: "Status"; font-size: 11px; font-weight: 600; color: #a1a1aa; vertical-alignment: center; }
                    Rectangle { width: 1px; background: #27272a; }
                }
                HorizontalLayout {
                    width: 80px; padding-left: 6px;
                    Text { text: "Time left"; font-size: 11px; font-weight: 600; color: #a1a1aa; vertical-alignment: center; }
                    Rectangle { width: 1px; background: #27272a; }
                }
                HorizontalLayout {
                    width: 90px; padding-left: 6px;
                    Text { text: "Transfer rate"; font-size: 11px; font-weight: 600; color: #a1a1aa; vertical-alignment: center; }
                    Rectangle { width: 1px; background: #27272a; }
                }
                HorizontalLayout {
                    width: 90px; padding-left: 6px;
                    HeaderCell { label: "Downloaded"; column: 3; active: root.sort_column == 3; ascending: root.sort_ascending; clicked(col) => { root.sort_requested(col); } }
                }
            }
        }

        Rectangle { height: 1px; background: #27272a; }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            if root.active_row_visible: Rectangle {
                height: 25px;
                background: root.selected_row == 0 ? #273248 : (act_t.has-hover ? #202024 : #18181b);
                border-width: list_focus.has-focus && root.keyboard_focused && root.selected_row == 0 ? 1px : 0px;
                border-color: FocusStyle.ring;
                accessible-role: button;
                accessible-label: root.active_filename + ", " + root.active_status;
                accessible-action-default => { root.selected_row = 0; root.row_selected(0); }

                DownloadRowColumns {
                    filename: root.active_filename != "" ? root.active_filename : "New Download";
                    file-type: root.active_file_type;
                    size-text: root.active_size;
                    status-text: root.active_status;
                    time-left-text: root.active_time_left;
                    transfer-rate-text: root.active_transfer_rate;
                    downloaded-text: root.active_downloaded;
                    is-active: true;
                    status-color: root.active_status_color;
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: #27272a; }
                act_t := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.keyboard_focused = false;
                        list_focus.focus();
                        root.selected_row = 0;
                        root.row_selected(0);
                    }
                    double-clicked => { if root.is_completed { root.open_file(); } }
                }
            }

            for item[idx] in root.sample_downloads: Rectangle {
                property <bool> is_visible: root.category_matches(
                    root.selected_category, item.file_type, true);
                // The keyboard marks the selected row, or the first listed row when the table
                // has no selection yet. A click selects the row without painting the ring.
                property <bool> is_focused: list_focus.has-focus && root.keyboard_focused
                    && (root.selected_row == item.id
                    || (!root.active_row_visible && root.selected_row <= 0 && idx == 0));

                height: self.is_visible ? 25px : 0px;
                background: root.selected_row == item.id ? #273248 : (s_touch.has-hover ? #202024 : (Math.mod(idx, 2) == 0 ? #141416 : #18181b));
                border-width: self.is_focused ? 1px : 0px;
                border-color: FocusStyle.ring;
                accessible-role: button;
                accessible-label: item.filename + ", " + item.status_text;
                accessible-action-default => { root.selected_row = item.id; root.row_selected(item.id); }

                s_touch := TouchArea {
                    enabled: parent.is_visible;
                    mouse-cursor: pointer;
                    clicked => {
                        root.keyboard_focused = false;
                        list_focus.focus();
                        root.selected_row = item.id;
                        root.row_selected(item.id);
                    }
                    double-clicked => { root.open_file(); }
                }

                if self.is_visible: DownloadRowColumns {
                    filename: item.filename;
                    file-type: item.file_type;
                    size-text: item.size_text;
                    status-text: item.status_text;
                    time-left-text: item.time_left_text;
                    transfer-rate-text: item.transfer_rate_text;
                    downloaded-text: item.downloaded_text;
                }
                if self.is_visible: Rectangle { y: parent.height - 1px; height: 1px; background: #27272a; }
            }
        }

        Rectangle {
            if root.total_items == 0 || (root.selected_category == 6 && !root.active_row_visible): VerticalLayout {
                padding: 24px;
                spacing: 6px;
                alignment: center;
                Text {
                    text: root.selected_category == 6 ? "No unfinished downloads" : "No downloads";
                    color: #d4d4d8;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.selected_category == 6 ? "Active, stopped, and failed downloads appear here." :
                        "Choose Add URL to start a download.";
                    color: #a1a1aa;
                    font-size: 11px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        if root.active_row_visible && root.is_paused: PausedTransferDetails {
            is-resumable: root.is_resumable;
        }
    }
}
