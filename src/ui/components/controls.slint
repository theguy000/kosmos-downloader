import { Slider } from "std-widgets.slint";
import { IconChevronDown, IconChevronRight, IconClose } from "icons.slint";

// Single focus-indicator color for the whole app.
export global FocusStyle {
    out property <color> ring: #8ba9d6;
}

export component CategoryRow inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> selected;
    in property <bool> child;
    in property <bool> last-child;
    in property <bool> expandable;
    in property <bool> expanded;
    callback clicked();
    callback toggle();
    callback activate();
    activate => {
        if root.enabled {
            if root.expandable && root.selected { root.toggle(); }
            root.clicked();
        }
    }

    height: 26px;
    background: !root.enabled ? transparent : (root.selected ? #273248 : (touch.has-hover ? #242428 : transparent));
    border-width: root.enabled && focus.has-focus ? 1px : 0px;
    border-color: FocusStyle.ring;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.enabled ? root.text : root.text + " (unavailable)";
    accessible-enabled: root.enabled;
    accessible-action-default => { root.activate(); }

    if root.child: Rectangle {
        x: 30px; y: 0px;
        width: 1px;
        height: root.last-child ? parent.height / 2 : parent.height;
        background: #34343b;
    }
    if root.child: Rectangle {
        x: 30px; y: parent.height / 2;
        width: 9px; height: 1px;
        background: #34343b;
    }

    Rectangle {
        x: root.child ? 44px : 24px;
        y: (parent.height - self.height) / 2;
        width: 16px; height: 16px;
        opacity: root.enabled ? 1 : 0.3;
        HorizontalLayout {
            alignment: center;
            @children
        }
    }
    Text {
        x: root.child ? 66px : 46px;
        width: parent.width - self.x - 8px;
        height: parent.height;
        text: root.text;
        font-size: 12px;
        font-weight: 400;
        color: !root.enabled ? #71717a : (root.selected ? #edf3ff : #c4c4cc);
        vertical-alignment: center;
        overflow: elide;
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.activate();
                return accept;
            }
            if root.expandable && ((event.text == Key.RightArrow && !root.expanded)
                || (event.text == Key.LeftArrow && root.expanded)) {
                root.toggle();
                return accept;
            }
            return reject;
        }
    }
    // Hit areas overlay the content; they must not participate in its layout.
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            focus.focus();
            root.activate();
        }
    }
    if root.expandable: Rectangle {
        x: 0px;
        width: 24px; height: parent.height;
        background: disclosure.has-hover ? #ffffff0c : transparent;
        if root.expanded: IconChevronDown { x: 8px; y: 9px; stroke: #a1a1aa; }
        if !root.expanded: IconChevronRight { x: 8px; y: 9px; stroke: #a1a1aa; }
        disclosure := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { focus.focus(); root.toggle(); }
        }
    }
}

export component IdmToolButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> enabled: true;
    callback clicked();
    public function take-focus() { focus.focus(); }

    width: 62px;
    height: 48px;
    background: !root.enabled ? transparent : (touch.pressed ? #34343b :
        (touch.has-hover ? #2b2b30 : transparent));
    border-width: root.enabled && focus.has-focus ? 1px : 0px;
    border-color: FocusStyle.ring;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    VerticalLayout {
        alignment: center;
        spacing: 3px;
        padding: 2px;

        Rectangle {
            height: 16px;
            opacity: root.enabled ? 1 : 0.3;
            HorizontalLayout {
                alignment: center;
                @children
            }
        }

        Text {
            text: root.text;
            font-size: 10px;
            color: !root.enabled ? #71717a : (touch.has-hover ? #f4f4f5 : #d4d4d8);
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { focus.focus(); root.clicked(); }
    }
}

export component PointerButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> filled: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    out property <bool> has_keyboard_focus: focus.has-focus;
    callback clicked(bool);
    public function take-focus() { focus.focus(); }

    width: root.text == "Download" ? 88px : 72px;
    height: 36px;
    background: !root.enabled ? #303034 : (root.danger ?
        (touch.pressed ? #991b1b : (touch.has-hover ? #dc2626 : #b91c1c)) :
        (touch.pressed ? #3b4658 :
        (root.primary ? (touch.has-hover ? #a7bfe2 : #8ba9d6) :
        (root.filled ? (touch.has-hover ? #45454d : #36363e) :
        (touch.has-hover ? #303036 : transparent)))));
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(true); } }

    // Drawn outside the fill, with a 1px gap, so the ring stays visible on accent-filled buttons.
    if root.enabled && focus.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        background: transparent;
        border-width: 1px;
        border-color: FocusStyle.ring;
    }

    Text {
        text: root.text;
        font-size: 12px;
        font-weight: root.primary ? 600 : 400;
        color: !root.enabled ? #92929b : (root.primary && !root.danger && !touch.pressed ? #18181b : #f4f4f5);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked(true);
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { focus.focus(); root.clicked(false); }
    }
}

export component DialogCloseButton inherits Rectangle {
    callback clicked(bool);
    out property <bool> has_keyboard_focus: focus.has-focus;
    public function take-focus() { focus.focus(); }

    width: 24px;
    height: 24px;
    background: touch.pressed ? #34343b : (touch.has-hover ? #2e2e34 : #252529);
    border-width: 1px;
    border-color: focus.has-focus || touch.pressed ? FocusStyle.ring : (touch.has-hover ? #71717a : #3f3f46);
    forward-focus: focus;
    accessible-role: button;
    accessible-label: "Close";
    accessible-action-default => { root.clicked(true); }

    IconClose {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        stroke: touch.has-hover ? #f4f4f5 : #a1a1aa;
    }

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked(true);
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(false); }
    }
}

export component DialogCheckBox inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> text;
    out property <bool> has_keyboard_focus: focus.has-focus;
    public function take-focus() { focus.focus(); }

    height: 36px;
    background: touch.pressed ? #2b2b30 : (touch.has-hover ? #27272a : transparent);
    forward-focus: focus;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-enabled: true;
    accessible-checkable: true;
    accessible-checked <=> root.checked;
    accessible-action-default => { root.checked = !root.checked; }

    // Drawn outside the box so the ring stays visible when the checked box is accent-filled.
    Rectangle {
        x: 1px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        background: transparent;
        border-width: focus.has-focus ? 1px : 0px;
        border-color: FocusStyle.ring;
    }

    Rectangle {
        x: 2px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        background: root.checked ? #8ba9d6 : #2b2b30;
        border-width: 1px;
        border-color: #71717a;

        if root.checked: Path {
            x: 2px;
            y: 2px;
            width: 14px;
            height: 14px;
            commands: "M 2 7 L 6 11 L 12 3";
            stroke: #18181b;
            stroke-width: 2px;
        }
    }

    Text {
        x: 30px;
        width: parent.width - self.x;
        height: parent.height;
        text: root.text;
        font-size: 12px;
        color: #d4d4d8;
        vertical-alignment: center;
    }

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.checked = !root.checked;
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.checked = !root.checked;
        }
    }
}

export component DialogRadioButton inherits Rectangle {
    in-out property <bool> selected: false;
    in property <string> text;
    out property <bool> has_keyboard_focus: focus.has-focus;
    callback clicked();
    public function take-focus() { focus.focus(); }

    height: 26px;
    background: touch.pressed ? #2b2b30 : (touch.has-hover ? #27272a : transparent);
    forward-focus: focus;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-enabled: true;
    accessible-checked <=> root.selected;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        x: 2px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        background: #2b2b30;
        border-width: 1px;
        border-color: root.selected || focus.has-focus ? FocusStyle.ring : #71717a;

        if root.selected: Rectangle {
            x: 4px;
            y: 4px;
            width: 8px;
            height: 8px;
            background: #8ba9d6;
        }
    }

    Text {
        x: 26px;
        width: parent.width - self.x;
        height: parent.height;
        text: root.text;
        font-size: 12px;
        color: #d4d4d8;
        vertical-alignment: center;
    }

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
}

export component DialogInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <string> label;
    in property <bool> read-only: false;
    out property <bool> has_keyboard_focus: input.has-focus;
    public function take-focus() { input.focus(); }
    callback accepted();
    private property <length> menu-x;
    private property <length> menu-y;
    private property <int> menu-index: -1;

    function open-menu(x: length, y: length) {
        root.menu-x = x;
        root.menu-y = y;
        root.menu-index = -1;
        input.focus();
        edit-menu.show();
    }

    function edit(index: int) {
        if index < 0 || index > 3 || (root.text.is-empty && index != 2) { return; }
        edit-menu.close();
        input.focus();
        if index == 0 { input.cut(); }
        if index == 1 { input.copy(); }
        if index == 2 { input.paste(); }
        if index == 3 { input.select-all(); }
    }

    height: 36px;
    horizontal-stretch: 1;
    clip: true;
    background: input.has-focus ? #303036 : #2b2b30;
    forward-focus: input;
    TouchArea { clicked => { input.focus(); } }
    if root.text == "": Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder-text;
        color: #a1a1aa;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    // The input handles selection; its parent receives otherwise unhandled right-clicks.
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                root.open-menu(self.mouse-x, self.mouse-y);
            }
        }

        input := TextInput {
            private property <length> computed-x;

            read-only: root.read-only;
            x: min(12px, max(parent.width - 12px - self.width - self.text-cursor-width, self.computed-x));
            width: max(parent.width - 24px - self.text-cursor-width, self.preferred-width);
            height: parent.height;
            text <=> root.text;
            single-line: true;
            accepted => { root.accepted(); }
            font-size: 12px;
            color: #f4f4f5;
            selection-background-color: #8ba9d6;
            selection-foreground-color: #18181b;
            vertical-alignment: center;
            accessible-label: root.label;
            cursor-position-changed(cursor-position) => {
                if cursor-position.x + self.computed-x < 12px {
                    self.computed-x = 12px - cursor-position.x;
                } else if cursor-position.x + self.computed-x > parent.width - 12px - self.text-cursor-width {
                    self.computed-x = parent.width - 12px - cursor-position.x - self.text-cursor-width;
                }
            }
            key-pressed(event) => {
                if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
                    root.open-menu(12px, root.height);
                    return accept;
                }
                return reject;
            }
        }
    }
    edit-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 196px;
        height: 120px;
        close-policy: close-on-click-outside;
        forward-focus: menu-focus;

        Rectangle {
            background: #1f1f23;
            border-width: 1px;
            border-color: #3b3b43;

            menu-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.DownArrow || event.text == Key.UpArrow {
                        root.menu-index = root.text.is-empty ? 2 :
                            (event.text == Key.DownArrow ? mod(root.menu-index + 1, 4) :
                            (root.menu-index <= 0 ? 3 : root.menu-index - 1));
                        return accept;
                    }
                    if event.text == Key.Return || event.text == Key.Space {
                        root.edit(root.menu-index);
                        return accept;
                    }
                    if event.text == Key.Escape || event.text == Key.Tab {
                        edit-menu.close();
                        input.focus();
                        return event.text == Key.Tab ? reject : accept;
                    }
                    if event.modifiers.control {
                        if event.text.to-lowercase() == "x" { root.edit(0); return accept; }
                        if event.text.to-lowercase() == "c" { root.edit(1); return accept; }
                        if event.text.to-lowercase() == "v" { root.edit(2); return accept; }
                        if event.text.to-lowercase() == "a" { root.edit(3); return accept; }
                    }
                    return reject;
                }

                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;
                    for item[index] in [
                        { title: "Cut", shortcut: "X" },
                        { title: "Copy", shortcut: "C" },
                        { title: "Paste", shortcut: "V" },
                        { title: "Select All", shortcut: "A" },
                    ]: menu-row := Rectangle {
                        private property <bool> available: index == 2 || !root.text.is-empty;
                        height: 28px;
                        background: !self.available ? transparent :
                            (menu-touch.pressed ? #3b4658 : (root.menu-index == index ? #303036 : transparent));
                        accessible-role: button;
                        accessible-label: item.title;
                        accessible-enabled: self.available;
                        accessible-action-default => { root.edit(index); }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: item.title;
                                font-size: 12px;
                                color: menu-row.available ? #f4f4f5 : #71717a;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Ctrl+" + item.shortcut;
                                font-size: 11px;
                                color: menu-row.available ? #a1a1aa : #71717a;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                        menu-touch := TouchArea {
                            enabled: parent.available;
                            changed has-hover => {
                                if self.has-hover {
                                    root.menu-index = index;
                                } else if root.menu-index == index {
                                    root.menu-index = -1;
                                }
                            }
                            clicked => { root.edit(index); }
                        }
                    }
                }
            }
        }
    }
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: input.has-focus ? FocusStyle.ring : transparent;
    }
}

export component DialogSlider inherits Rectangle {
    in-out property <float> value;
    out property <bool> has_keyboard_focus: slider.has-focus;
    public function take-focus() { slider.focus(); }
    height: 28px;
    horizontal-stretch: 1;
    forward-focus: slider;

    Rectangle {
        x: 10px; y: (parent.height - self.height) / 2;
        width: parent.width - 20px; height: 3px;
        background: #45454d;
        Rectangle {
            x: 0px;
            width: parent.width * (root.value - 1) / 15;
            background: #8ba9d6;
        }
    }
    // Drawn outside the handle so the ring stays visible on the accent-filled handle.
    if slider.has-focus: Rectangle {
        x: 2px + (parent.width - 20px) * (root.value - 1) / 15;
        y: (parent.height - self.height) / 2;
        width: 16px; height: 20px;
        background: transparent;
        border-width: 1px;
        border-color: FocusStyle.ring;
    }
    Rectangle {
        x: 4px + (parent.width - 20px) * (root.value - 1) / 15;
        y: (parent.height - self.height) / 2;
        width: 12px; height: 16px;
        background: #8ba9d6;
    }
    // Keep native slider input and accessibility; replace only its paint.
    slider := Slider {
        width: parent.width; height: parent.height;
        opacity: 0;
        minimum: 1; maximum: 16; step: 1;
        value <=> root.value;
        changed(value) => { root.value = Math.round(value); }
        accessible-label: "Streams";
    }
}
