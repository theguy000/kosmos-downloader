import { Palette } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { CategoryRow, FocusStyle } from "controls.slint";
import {
    FileTypeIcon,
    IconCheck,
    IconFolder,
    IconGrabber,
    IconQueue,
    IconSidebarToggle,
    IconUnfinished,
} from "icons.slint";

struct Subcategory {
    name: string,
    icon: string,
}

export component CategorySidebar inherits Rectangle {
    in-out property <int> selected_category;
    in-out property <bool> all_downloads_expanded;
    in-out property <bool> collapsed: false;

    private property <[Subcategory]> subcategories: [
        { name: "Compressed", icon: "zip" },
        { name: "Documents", icon: "doc" },
        { name: "Music", icon: "audio" },
        { name: "Programs", icon: "exe" },
        { name: "Video", icon: "video" },
        { name: "Images", icon: "image" },
        { name: "Ebooks", icon: "ebook" },
        { name: "Source Code", icon: "code" },
        { name: "Disk Images", icon: "iso" },
        { name: "Torrents", icon: "torrent" },
        { name: "Databases", icon: "db" },
    ];

    width: root.collapsed ? 28px : 200px;
    background: Palette.background;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 25px;
            background: Palette.surface-alt;

            if !root.collapsed: Text {
                x: 10px;
                y: 0px;
                width: parent.width - 36px;
                height: parent.height;
                text: "Categories";
                font-size: 11px;
                font-weight: 600;
                color: Palette.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }

            collapse_btn := Rectangle {
                x: root.collapsed ? (parent.width - self.width) / 2 : parent.width - self.width - 4px;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                background: btn_touch.pressed ? Palette.control-pressed : (btn_touch.has-hover ? Palette.control : transparent);
                border-width: btn_focus.has-focus ? 1px : 0px;
                border-color: FocusStyle.ring;
                forward-focus: btn_focus;
                accessible-role: button;
                accessible-label: root.collapsed ? "Expand categories" : "Collapse categories";

                IconSidebarToggle {
                    collapsed: root.collapsed;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    stroke: btn_touch.has-hover ? Palette.text-primary : Palette.text-muted;
                }

                btn_focus := FocusScope {
                    key-pressed(event) => {
                        if event.text == Key.Space || event.text == Key.Return {
                            root.collapsed = !root.collapsed;
                            return accept;
                        }
                        return reject;
                    }
                }

                btn_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.collapsed = !root.collapsed;
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Palette.border; }

        if !root.collapsed: VerticalLayout {
            padding: 6px;
            spacing: 0px;

            CategoryRow {
                text: "All Downloads";
                selected: root.selected_category == 0;
                expandable: true;
                expanded: root.all_downloads_expanded;
                clicked => { root.selected_category = 0; }
                toggle => {
                    root.all_downloads_expanded = !root.all_downloads_expanded;
                    if !root.all_downloads_expanded && root.selected_category >= 1 && root.selected_category <= 11 {
                        root.selected_category = 0;
                    }
                }
                IconFolder {}
            }

            if root.all_downloads_expanded: ScrollView {
                vertical-stretch: 1;
                max-height: 11 * 26px;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                VerticalLayout {
                    spacing: 0px;
                    padding: 0px;

                    for subcat[index] in root.subcategories: CategoryRow {
                        text: subcat.name;
                        child: true;
                        last-child: index == 10;
                        selected: root.selected_category == index + 1;
                        clicked => { root.selected_category = index + 1; }
                        FileTypeIcon { file-type: subcat.icon; }
                    }
                }
            }

            Rectangle {
                height: 6px;
                Rectangle { x: 24px; y: 3px; width: parent.width - 32px; height: 1px; background: Palette.separator; }
            }

            CategoryRow {
                text: "Unfinished";
                selected: root.selected_category == 12;
                clicked => { root.selected_category = 12; }
                IconUnfinished {}
            }

            CategoryRow {
                text: "Finished";
                selected: root.selected_category == 13;
                clicked => { root.selected_category = 13; }
                IconCheck {}
            }

            Rectangle {
                height: 6px;
                Rectangle { x: 24px; y: 3px; width: parent.width - 32px; height: 1px; background: Palette.separator; }
            }

            CategoryRow {
                text: "Grabber projects";
                enabled: false;
                selected: root.selected_category == 14;
                clicked => { root.selected_category = 14; }
                IconGrabber {}
            }

            CategoryRow {
                text: "Queues";
                enabled: false;
                selected: root.selected_category == 15;
                clicked => { root.selected_category = 15; }
                IconQueue {}
            }
        }

        Rectangle {}
    }
}
