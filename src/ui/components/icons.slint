export component FileTypeIcon inherits VerticalLayout {
    in property <string> file-type;
    alignment: center;

    if root.file-type == "exe": IconProgram {}
    if root.file-type == "zip": IconArchive {}
    if root.file-type == "video": IconMedia {}
    if root.file-type == "audio": IconAudio {}
    if root.file-type == "doc": IconDoc {}
    if root.file-type == "image": IconImage {}
    if root.file-type == "ebook": IconEbook {}
    if root.file-type == "code": IconCode {}
    if root.file-type == "iso": IconDisk {}
    if root.file-type == "torrent": IconTorrent {}
    if root.file-type == "db": IconDatabase {}
}
