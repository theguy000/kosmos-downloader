import { Palette } from "theme.slint";
export component IconAdd inherits Path {
    width: 16px; height: 16px;
    commands: "M 8 2 L 8 14 M 2 8 L 14 8";
    stroke: Palette.success;
    stroke-width: 1.5px;
}

export component IconResume inherits Path {
    width: 16px; height: 16px;
    commands: "M 5 3 L 13 8 L 5 13 Z";
    stroke: Palette.success;
    fill: Palette.success-fill;
    stroke-width: 1.2px;
}

