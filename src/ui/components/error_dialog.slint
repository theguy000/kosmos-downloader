import { Palette } from "theme.slint";
import { PointerButton } from "controls.slint";

export component ErrorDialog inherits Rectangle {
    in-out property <string> active_error_message: "";
    in-out property <string> action_error_message: "";

    function dismiss() {
        root.action_error_message = "";
        root.active_error_message = "";
    }

    background: Palette.overlay;
    forward-focus: dialog_focus;
    init => { ok_button.take-focus(); }

    TouchArea {}

    dialog_focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Return || event.text == " " {
                root.dismiss();
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 440px;
            height: 188px;
            background: Palette.surface;
            accessible-role: groupbox;
            accessible-label: root.active_error_message != "" ? "Download failed" : "Action unavailable";

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    height: 24px;
                    text: root.active_error_message != "" ? "Download failed" : "Action unavailable";
                    font-size: 15px;
                    font-weight: 600;
                    color: Palette.text-primary;
                }

                Text {
                    text: root.action_error_message != "" ? root.action_error_message : root.active_error_message;
                    color: Palette.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Rectangle {}

                HorizontalLayout {
                    alignment: end;

                    ok_button := PointerButton {
                        text: "OK";
                        primary: true;
                        clicked => { root.dismiss(); }
                    }
                }
            }
        }
    }
}
