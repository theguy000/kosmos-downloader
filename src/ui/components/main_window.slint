// Inter 4.1: https://github.com/rsms/inter/releases/tag/v4.1 (SIL OFL 1.1).
import "../fonts/InterVariable.ttf";

import { AddDownloadDialog } from "add_download_dialog.slint";
import { DeleteConfirmationDialog } from "delete_confirmation_dialog.slint";
import { DownloadTable, TableItem } from "download_table.slint";
import { DuplicateDownloadDialog } from "duplicate_dialog.slint";
import { ErrorDialog } from "error_dialog.slint";
import { OptionsDialog } from "options_dialog.slint";
import { CategorySidebar } from "sidebar.slint";
import { ApplicationToolbar } from "toolbar.slint";
import { StatusFooter } from "transfer_details.slint";

export component MainWindow inherits Window {
    title: "Kosmos Downloader";
    icon: @image-url("../../../assets/kosmos-logo.png");
    default-font-family: "Inter Variable";
    preferred-width: 960px;
    preferred-height: 540px;
    min-width: 760px;
    min-height: 420px;
    background: #18181b;

    in-out property <string> url_text: "";
    in-out property <string> dest_dir_text: "";
    in-out property <float> streams_count: 8;
    in-out property <bool> show_add_dialog: false;
    in-out property <bool> show_options_dialog: false;
    in-out property <int> options_selected_tab: 0;
    in-out property <bool> show_delete_dialog: false;
    in-out property <bool> show_duplicate_dialog: false;
    in-out property <string> duplicate_url: "";
    in-out property <string> duplicate_filename: "";
    in-out property <string> duplicate_existing_size: "";
    in-out property <bool> duplicate_is_link: true;
    in-out property <int> duplicate_selected_option: 0;
    in-out property <bool> duplicate_remember: false;
    in-out property <string> delete_filename: "";
    in-out property <bool> delete_completed_only: false;
    in-out property <bool> delete_target_completed: false;
    in-out property <bool> delete_file: false;
    in-out property <int> selected_category: 0;
    in-out property <int> selected_row: 0;
    in-out property <bool> all_downloads_expanded: true;

    in-out property <bool> has_active_download: false;
    in-out property <bool> is_downloading: false;
    in-out property <bool> is_paused: false;
    in-out property <bool> is_completed: false;
    in-out property <bool> is_resumable: false;
    in-out property <string> active_filename: "";
    in-out property <string> active_file_type: "doc";
    in-out property <string> active_size: "0 B";
    in-out property <string> active_status: "Idle";
    in-out property <color> active_status_color: #71717a;
    in-out property <string> active_time_left: "--:--";
    in-out property <string> active_transfer_rate: "0 KB/s";
    in-out property <string> active_last_try: "Today";
    in-out property <string> active_error_message: "";
    in-out property <string> action_error_message: "";
    pure function category_matches(category: int, file_type: string, completed: bool) -> bool {
        return category == 0
            || (category == 1 && file_type == "zip")
            || (category == 2 && file_type == "doc")
            || (category == 3 && file_type == "audio")
            || (category == 4 && file_type == "exe")
            || (category == 5 && file_type == "video")
            || (category == 6 && !completed)
            || (category == 7 && completed);
    }
    out property <bool> active_row_visible: root.has_active_download && root.category_matches(
        root.selected_category, root.active_file_type, root.is_completed);
    out property <bool> can_resume: !root.show_duplicate_dialog && root.active_row_visible && root.selected_row == 0 && root.is_paused;
    out property <bool> can_stop: !root.show_duplicate_dialog && root.active_row_visible && root.selected_row == 0 && root.is_downloading;
    out property <bool> can_stop_all: !root.show_duplicate_dialog && root.has_active_download && root.is_downloading;
    out property <bool> can_delete_selected: !root.show_duplicate_dialog && root.active_row_visible && root.selected_row == 0;
    out property <bool> can_delete_completed: !root.show_duplicate_dialog && root.has_active_download && root.is_completed;
    out property <int> total_items: root.sample_downloads.length + (root.has_active_download ? 1 : 0);

    in-out property <[TableItem]> sample_downloads: [];

    callback start_download();
    callback pause_download();
    callback resume_download();
    callback request_delete_selected();
    callback request_delete_completed();
    callback confirm_delete(bool);
    callback dismiss_delete();
    callback resolve_duplicate(int, bool);
    callback dismiss_duplicate();
    callback browse_folder();
    callback open_file();

    public function close-add-dialog() {
        root.show_add_dialog = false;
        toolbar.focus-add();
    }

    public function close-delete-dialog() {
        root.show_delete_dialog = false;
        root.delete_file = false;
        if root.delete_completed_only { toolbar.focus-delete-completed(); }
        else { toolbar.focus-delete-selected(); }
        root.dismiss-delete();
    }

    public function close-duplicate-dialog() {
        root.show_duplicate_dialog = false;
        root.dismiss-duplicate();
    }

    public function close-options-dialog() {
        root.show_options_dialog = false;
        toolbar.focus-options();
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        toolbar := ApplicationToolbar {
            has-active-download: root.has_active_download;
            is-completed: root.is_completed;
            is-paused: root.is_paused;
            is-resumable: root.is_resumable;
            can-resume: root.can_resume;
            can-stop: root.can_stop;
            can-stop-all: root.can_stop_all;
            can-delete-selected: root.can_delete_selected;
            can-delete-completed: root.can_delete_completed;
            show-add-dialog => { root.show_add_dialog = true; }
            show-options-dialog => { root.show_options_dialog = true; }
            pause-download => { root.pause_download(); }
            resume-download => { root.resume_download(); }
            request-delete-selected => { root.request-delete-selected(); }
            request-delete-completed => { root.request-delete-completed(); }
            open-file => { root.open_file(); }
        }

        HorizontalLayout {
            spacing: 0px;

            CategorySidebar {
                selected-category <=> root.selected_category;
                all-downloads-expanded <=> root.all_downloads_expanded;
            }

            Rectangle { width: 1px; background: #27272a; }

            DownloadTable {
                active-row-visible: root.active_row_visible;
                selected-row <=> root.selected_row;
                is-completed: root.is_completed;
                is-paused: root.is_paused;
                is-resumable: root.is_resumable;
                active-filename: root.active_filename;
                active-file-type: root.active_file_type;
                active-size: root.active_size;
                active-status: root.active_status;
                active-status-color: root.active_status_color;
                active-time-left: root.active_time_left;
                active-transfer-rate: root.active_transfer_rate;
                active-last-try: root.active_last_try;
                selected-category: root.selected_category;
                total-items: root.total_items;
                sample-downloads: root.sample_downloads;
                open-file => { root.open_file(); }
            }
        }

        Rectangle { height: 1px; background: #27272a; }

        StatusFooter {
            selected-category: root.selected_category;
            active-row-visible: root.active_row_visible;
            total-items: root.total_items;
            is-downloading: root.is_downloading;
            active-transfer-rate: root.active_transfer_rate;
            streams-count: root.streams_count;
        }
    }

    if root.show_add_dialog: AddDownloadDialog {
        url-text <=> root.url_text;
        dest-dir-text <=> root.dest_dir_text;
        streams-count <=> root.streams_count;
        browse-folder => { root.browse_folder(); }
        start-download => { root.start_download(); }
        dismiss => { root.close-add-dialog(); }
    }

    if root.show_options_dialog: OptionsDialog {
        selected-tab <=> root.options_selected_tab;
        dismiss => { root.close-options-dialog(); }
    }

    if root.show-delete-dialog: delete_dialog := DeleteConfirmationDialog {
        filename: root.delete-filename;
        completed-only: root.delete-completed-only;
        target-completed: root.delete-target-completed;
        delete-file <=> root.delete-file;
        dismiss => { root.close-delete-dialog(); }
        confirm(delete-file) => { root.confirm-delete(delete-file); }
    }

    if root.show_duplicate_dialog: DuplicateDownloadDialog {
        url: root.duplicate_url;
        filename: root.duplicate_filename;
        existing_size: root.duplicate_existing_size;
        is_link_duplicate: root.duplicate_is_link;
        selected_option <=> root.duplicate_selected_option;
        remember <=> root.duplicate_remember;
        dismiss => { root.close-duplicate-dialog(); }
        confirm(option, remember) => {
            root.show_duplicate_dialog = false;
            root.resolve_duplicate(option, remember);
        }
    }

    if root.action_error_message != "" || root.active_error_message != "": ErrorDialog {
        active-error-message <=> root.active_error_message;
        action-error-message <=> root.action_error_message;
    }
}
